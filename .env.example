# Copie para .env e preencha. NUNCA versione o .env.
# Gere segredos com:  openssl rand -hex 32   (hex = seguro para usar em URLs)

# Porta publicada no host (acesso via http://<IP-do-VPS>:<porta>)
HTTP_PORT=80

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Mínimo 32 caracteres:  openssl rand -base64 48
JWT_ACCESS_SECRET=
# Exatamente 32 bytes em base64:  openssl rand -base64 32
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Quizzer

# HTTPS (ver docs/features/017-https.md). Use os scripts de infra/tls para mudar de modo:
#   infra/tls/gerar-autoassinado.sh <IP>          -> TLS_MODO=autoassinado
#   infra/tls/ativar-letsencrypt.sh <dominio> <email> -> TLS_MODO=letsencrypt
TLS_MODO=desligado
TLS_DOMINIO=
HTTPS_PORT=443
PORTA_HTTPS_PUBLICA=443
# Cookies Secure + HSTS na API: true sempre que TLS_MODO != desligado
TLS_ATIVO=false
# HSTS "preload" (ADR-0055): só para domínio próprio registrável (ex.: quizzer.com.br), nunca
# para subdomínio da instituição — a inscrição em hstspreload.org fixa o domínio inteiro.
HSTS_PRELOAD=false

# Fuso horário da instituição (nome IANA): períodos de relatórios/auditoria e datas nas mensagens
# (ADR-0058). Maceió = horário de Brasília, sem horário de verão.
FUSO_HORARIO=America/Maceio
# COMPOSE_PROFILES=letsencrypt   # liga o renovador automático do certificado
LOG_LEVEL=info
IMAGE_TAG=latest
# Nome da instituição no menu lateral e link da "Central de ajuda" (vazio = cartão oculto).
# Embutidos no build do frontend: após mudar, rode `docker compose build nginx`.
NOME_INSTITUICAO=Unima
URL_AJUDA=
# (CONTATO_ENCARREGADO, mais abaixo, também é embutido no build do frontend)

# Backup automatizado do PostgreSQL (serviço `backup`)
BACKUP_DIR=./backups
BACKUP_INTERVALO_HORAS=24
BACKUP_RETENCAO_DIAS=7
# Criptografia (recomendado): chave pública gerada por infra/backup/gerar-chave.sh
BACKUP_AGE_DESTINATARIO=
# Cópia fora do VPS (recomendado): destino rclone, ex. "offsite:quizzer-backups".
# Configure o remoto em infra/backup/rclone/rclone.conf (ver docs/features/018-backup-externo.md)
BACKUP_RCLONE_DESTINO=
# Alerta de falha: URL que recebe POST JSON {"text": "..."} (Slack, Teams, Google Chat…)
BACKUP_WEBHOOK_FALHA=

# Monitor (API, Nginx, certificado, backup, disco) — ADR-0036. Sem MONITOR_WEBHOOK, usa o
# BACKUP_WEBHOOK_FALHA; sem nenhum dos dois, só registra no log (docker compose logs monitor).
MONITOR_WEBHOOK=
MONITOR_INTERVALO_MIN=5
MONITOR_CERT_DIAS=14
MONITOR_DISCO_PCT=90
# Erros 5xx e latência da API na janela do intervalo (ADR-0054); abaixo de MONITOR_MIN_REQUISICOES
# requisições na janela, não avalia (evita alarme com 1 erro em 2 acessos de madrugada).
MONITOR_5XX_PCT=5
MONITOR_P95_MS=2000
MONITOR_MIN_REQUISICOES=20
# Com cópia externa, cobra o teste de restauração (infra/backup/testar-copia-externa.sh) a cada
# tantos dias; 0 desliga.
MONITOR_RESTAURACAO_DIAS=35

# Centralização de logs (opcional — ADR-0054): descomente para somar o coletor (Vector).
# COMPOSE_FILE=docker-compose.yml:docker-compose.logs.yml
LOGS_DIR=./logs
LOGS_RETENCAO_DIAS=30
# Encaminhar para fora do VPS (opcional): NDJSON por HTTP e/ou Grafana Loki
LOGS_ENCAMINHAR_HTTP=
LOGS_ENCAMINHAR_TOKEN=
LOGS_LOKI_URL=

# E-mail (opcional — ADR-0041): "esqueci minha senha", convite de primeiro acesso e cópia das
# notificações. Sem SMTP_HOST tudo funciona sem e-mail (senhas temporárias pela administração).
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=Quizzer <nao-responda@sua-instituicao.edu.br>
# Endereço público do sistema (links dos e-mails)
APP_URL=https://provas.sua-instituicao.edu.br
# Versão dos Termos de Uso e da Política de Privacidade (ADR-0060). Deve ser igual a
# VERSAO_DOCUMENTOS_LEGAIS em apps/web/src/legal/documentos.ts; muda junto com o texto.
POLITICA_VERSAO=2026-10-27
# Contato do encarregado de dados (DPO) exibido nos Termos e na Política (ex.: e-mail). Vazio = texto genérico.
CONTATO_ENCARREGADO=

# Retenção (LGPD): dias até anonimizar participantes de prova pública. 0 = desligado (decisão do DPO)
RETENCAO_EXTERNOS_DIAS=0
# Notificações já lidas são apagadas depois de tantos dias (0 = nunca apagar)
NOTIFICACOES_RETENCAO_DIAS=180
