# Desenvolvimento local da API (copie para apps/api/.env).
# Infra local: npm run dev:infra  (docker-compose.dev.yml)
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://quizzer:quizzer_dev@127.0.0.1:5432/quizzer
REDIS_URL=redis://127.0.0.1:6379
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 32
MFA_ENCRYPTION_KEY=
TLS_ATIVO=false
TRUST_PROXY=0
# Senha dos usuários criados pelo seed (npm run db:seed -w @quizzer/api)
SEED_SENHA_PADRAO=

# Mídias das questões (imagens/áudios) — no Docker é o volume "midias" (ADR-0032)
MIDIAS_DIR=./dados/midias
MIDIAS_MAX_MB=5

# E-mail opcional (ADR-0041). Em desenvolvimento, EMAIL_TRANSPORTE=memoria simula o envio.
SMTP_HOST=
APP_URL=http://localhost:5173
